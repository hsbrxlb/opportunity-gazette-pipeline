{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity Gazette unattended review queue",
  "type": "object",
  "required": ["schemaVersion", "targetDate", "generatedAt", "status", "counts", "sources", "candidates", "queueStrategy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "targetDate": {"type": "string", "format": "date"},
    "status": {"const": "ready_for_review"},
    "counts": {
      "type": "object",
      "required": ["fullCandidates", "queuedCandidates", "overflowCandidates", "sourceFailures"]
    },
    "candidates": {"type": "array", "maxItems": 48}
  }
}
